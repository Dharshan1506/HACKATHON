{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start PackSure AI (Full Stack)",
      "type": "shell",
      "command": "py run_all.py",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🐍 Start Backend (FastAPI)",
      "type": "shell",
      "command": "py run.py",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "⚡ Start Frontend (Vite Dev)",
      "type": "shell",
      "command": "cmd /c npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🔨 Build Frontend",
      "type": "shell",
      "command": "cmd /c npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    }
  ]
}
