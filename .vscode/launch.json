{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "⚡ Run PackSure AI (Single File App)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/packsure_app.py",
      "console": "integratedTerminal"
    },
    {
      "name": "🚀 Run PackSure AI (Full Stack Dual Process)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "console": "integratedTerminal"
    },
    {
      "name": "🐍 Run Backend Only (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    }
  ]
}
